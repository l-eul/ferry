VITE_AUTH_ENABLED=false

# Telegram MTProto credentials from https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_your_api_hash

# Optional but recommended in production. Used to encrypt saved Telegram sessions at rest.
# If omitted, TELEGRAM_API_HASH is used as the encryption secret.
# FERRY_SESSION_KEY=replace_with_a_long_random_secret

# Optional production database. Without this, the app uses its local PGLite fallback.
# DATABASE_URL=postgresql://user:password@host/database
